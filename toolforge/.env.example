# Copy to .env and fill in your keys.  (.env is gitignored.)
# Two providers, both spoken to via the OpenAI SDK; each capability falls back to the
# other provider for reliability. See config.py / llm.py.

# ---- OpenAI (https://platform.openai.com/api-keys) ----
OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=                # leave unset for real OpenAI (api.openai.com)
OPENAI_VISION_MODEL=gpt-4o        # must accept image input
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o               # used by the TypeScript dashboard's live mode (separate)

# ---- GrafiLab (OpenAI-compatible: Gemini / Qwen / GLM ...) ----
GRAFILAB_API_KEY=sk-grafilab-...
GRAFILAB_BASE_URL=https://api.grafilab.ai/v1
GRAFILAB_VISION_MODEL=qwen2.5-vl-72b-instruct   # confirm exact id via: python check_models.py
GRAFILAB_TEXT_MODEL=glm-5.2                      # confirm exact id via: python check_models.py

# ---- Routing (accuracy-first; comma-separated, first = primary) ----
VISION_CHAIN=openai,grafilab      # vision: OpenAI primary (best GUI control) -> GrafiLab fallback
TEXT_CHAIN=grafilab,openai        # text: GrafiLab primary (cheap) -> OpenAI fallback
LLM_TIMEOUT=60                    # per-call seconds before failing over

# ---- Generated REST API auth (NOT an LLM key) ----
TOOLFORGE_API_KEY=dev-secret-key
